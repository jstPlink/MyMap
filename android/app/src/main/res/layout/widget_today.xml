<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_glass_light">

    <LinearLayout
        android:id="@+id/w_col_lbl"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="34dp"
        android:paddingLeft="11dp"
        android:layout_marginRight="10dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="0dp"
            android:text=" "
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:layout_gravity="left"
            android:gravity="center_vertical"
            android:text="oggi"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:gravity="center"
            android:paddingTop="0dp"
            android:paddingBottom="11dp"
            android:text="7g"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
    </LinearLayout>
    <ImageView
        android:layout_width="1dp"
        android:layout_height="46dp"
        android:background="#33000000" />
    <LinearLayout
        android:id="@+id/w_col_km"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="6dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="0dp"
            android:text="km"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="16.8sp"
            android:textStyle="bold"
            android:textColor="#1B1B1B"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_km_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:paddingTop="0dp"
            android:paddingBottom="11dp"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_col_places"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="6dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="0dp"
            android:text="posti"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_places"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="16.8sp"
            android:textStyle="bold"
            android:textColor="#1B1B1B"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_places_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:paddingTop="0dp"
            android:paddingBottom="11dp"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_col_time"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="6dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="0dp"
            android:text="movimento"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="16.8sp"
            android:textStyle="bold"
            android:textColor="#1B1B1B"
            android:maxLines="1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/w_time_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:paddingTop="0dp"
            android:paddingBottom="11dp"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
    </LinearLayout>
    <ImageView
        android:layout_width="1dp"
        android:layout_height="46dp"
        android:layout_marginLeft="6dp"
        android:background="#33000000" />
    <LinearLayout
        android:id="@+id/w_col_pos"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="88dp"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:layout_marginLeft="6dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_lbl_pos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="0dp"
            android:text="tracker"
            android:includeFontPadding="false"
            android:textSize="11.2sp"
            android:textStyle="bold"
            android:textColor="#D9707070"
            android:maxLines="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            <ViewFlipper
                android:id="@+id/w_flip_still"
                android:layout_width="23.1dp"
                android:layout_height="23.1dp"
                android:autoStart="true"
                android:flipInterval="500"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out">
            <ImageView
                android:id="@+id/still_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_still_0" />
            <ImageView
                android:id="@+id/still_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_still_1" />
            <ImageView
                android:id="@+id/still_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_still_2" />
            <ImageView
                android:id="@+id/still_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_still_3" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/w_flip_steps"
                android:layout_width="23.1dp"
                android:layout_height="23.1dp"
                android:autoStart="true"
                android:flipInterval="500"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out">
            <ImageView
                android:id="@+id/steps_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_steps_0" />
            <ImageView
                android:id="@+id/steps_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_steps_1" />
            <ImageView
                android:id="@+id/steps_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_steps_2" />
            <ImageView
                android:id="@+id/steps_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_steps_3" />
            </ViewFlipper>
            <TextView
                android:id="@+id/w_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="16.8sp"
                android:textStyle="bold"
                android:textColor="#1B1B1B"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
